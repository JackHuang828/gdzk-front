{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.js",
    "eslint.config.js",
    "tools/**/*.js",
    "tools/**/*.cjs",
    "tools/**/*.mjs"
  ]
}
